# ==============================================================================
# AgentReliability AI — Backend Production Environment Template
# ==============================================================================
# Copy this file to .env in local development.
# In production (Render, Railway, Fly.io), set these in your cloud provider's dashboard.
# NEVER commit raw passwords, tokens, or secret keys to Git.
# ==============================================================================

# Environment Mode: 'production', 'staging', or 'development'
AGENTRELIABILITY_ENV=production

# Server Listening Port (automatically set by PaaS like Render/Railway)
PORT=8001

# Database Configuration:
# - For SQLite (single instance / dev):
#   AGENTRELIABILITY_DB=/var/data/agentreliability.db
# - For PostgreSQL (managed Postgres / cloud):
#   DATABASE_URL=postgresql://user:password@host:5432/agentreliability_db
AGENTRELIABILITY_DB=agentreliability.db

# Cookie Security:
# 'true' ensures session cookies are transmitted ONLY over HTTPS.
# Defaults to 'true' automatically whenever AGENTRELIABILITY_ENV=production.
# For decoupled frontend (Vercel) and backend (Render), use 'none'. For same-origin custom domains, use 'lax'.
AGENTRELIABILITY_COOKIE_SECURE=true
AGENTRELIABILITY_COOKIE_SAMESITE=none

# Allowed CORS Origins:
# Comma-separated list of trusted web client URLs
AGENTRELIABILITY_ALLOWED_ORIGINS=https://agentreliability.vercel.app,https://app.agentreliability.com
# Regex matching Vercel preview branch deployments
AGENTRELIABILITY_ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Session Expiration (in seconds):
# 604800 = 7 days
AGENTRELIABILITY_SESSION_MAX_AGE_SECONDS=604800

# Rate Limiting:
# Max failed attempts per window per IP
AGENTRELIABILITY_RATE_LIMIT_MAX=5
AGENTRELIABILITY_RATE_LIMIT_WINDOW=900

# Transactional Email Service (Resend / AWS SES / SMTP):
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=noreply@agentreliability.com

