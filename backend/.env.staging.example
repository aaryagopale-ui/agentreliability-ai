# ==============================================================================
# AgentReliability AI — Backend Staging Environment Template
# ==============================================================================
# Set these in the Render/Railway Staging Web Service Dashboard.
# NEVER commit live credentials to version control.
# ==============================================================================

# Environment Identifier
AGENTRELIABILITY_ENV=staging

# Server Listening Port (Injected automatically by Render/Railway)
PORT=8001

# PostgreSQL Staging Database (From Neon Staging Project)
# Example: postgresql://staging_user:password@ep-staging-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Staging Allowed CORS Origins (Frontend Staging URL)
# Example: https://agentreliability-frontend-staging.vercel.app
AGENTRELIABILITY_ALLOWED_ORIGINS=https://agentreliability-frontend-staging.vercel.app

# Secure Cookies (Required for HTTPS environments)
AGENTRELIABILITY_COOKIE_SECURE=true
AGENTRELIABILITY_COOKIE_SAMESITE=lax
AGENTRELIABILITY_SESSION_MAX_AGE_SECONDS=604800

# Rate Limiting
AGENTRELIABILITY_RATE_LIMIT_MAX=10
AGENTRELIABILITY_RATE_LIMIT_WINDOW=900

# Transactional Email (Resend Staging API Key)
RESEND_API_KEY=
EMAIL_FROM=staging@agentreliability.dev

