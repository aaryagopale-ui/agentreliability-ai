# ==============================================================================
# AgentReliability AI — Public Demo Environment Template
# ==============================================================================
# Use this configuration for the separate public demo deployment:
# https://agentreliability-demo.vercel.app
#
# Configure this environment variable in the second Vercel project's settings:
# Project Settings -> Environment Variables -> Add:
#
# Key:   VITE_DEMO_MODE
# Value: true
# Target: Production, Preview, Development
# ==============================================================================

VITE_DEMO_MODE=true

# Leave VITE_API_BASE_URL blank — the demo runs client-side with rich synthetic data,
# guaranteeing zero cold starts, zero backend costs, and zero access to production data.
VITE_API_BASE_URL=

